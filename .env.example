# Copia este archivo como .env

# true  -> usa el simulador interno (no necesita backend). Valor por defecto.
# false -> usa el backend real descrito en docs/INTEGRACION_API.md
VITE_USE_MOCK=true

# URL base de la API. Con el proxy de Vite basta con /api.
# En producción puede ser una URL completa: https://api.midominio.cl/api
VITE_API_URL=/api

# Dirección del backend en desarrollo (solo para el proxy de Vite)
VITE_API_PROXY=http://localhost:8000
